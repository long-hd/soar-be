<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Shared foundation — no Spring Boot starters, kept lightweight.

        Contains:
        - BaseEntity (@MappedSuperclass with audit fields)
        - CommonResult<T> (API response wrapper)
        - PageParam, PageResult<T> (pagination)
        - ServiceException, ErrorCode (error handling)
        - Utility classes
    -->
    <parent>
        <groupId>com.hdl.boot</groupId>
        <artifactId>soar-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>soar-common</artifactId>

    <name>${project.artifactId}</name>
    <description>Shared base classes, exceptions, and utilities used across all modules.</description>

    <dependencies>
        <!--
            JPA API — just annotations (@MappedSuperclass, @Column, @Id).
            NOT Hibernate runtime. Lightweight (no transitive deps).
            Actual JPA implementation comes via spring-boot-starter-data-jpa
            in modules that need it (system-biz, server).
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Validation annotations (@NotBlank, @NotNull, @Size) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Jackson annotations (@JsonFormat, @JsonIgnore, @JsonInclude) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>

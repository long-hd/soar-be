<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>soar</artifactId>
        <groupId>com.hdl.boot</groupId>
        <version>${revision}</version>
    </parent>
    <packaging>jar</packaging>

    <artifactId>soar-module-infra</artifactId>
    <name>${project.artifactId}</name>
    <url>https://github.com/long-hd/soar-be.git</url>
    <description>
        The infra module mainly provides two categories of capabilities:
        1. Infrastructure operations and management, supporting upper-layer common and core business services. For example: scheduled job management, server information, etc.
        2. Development tools that improve development efficiency and quality. For example: code generators, API documentation, etc.
    </description>

    <dependencies>
        <!-- Business components -->
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- AWS S3 client + presigner (S3-compatible storage: SeaweedFS, AWS S3) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- In-memory cache for the file client factory (refresh-after-write) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- MIME type detection for uploaded files -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>

        <!-- DB -->
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hdl.boot</groupId>
            <artifactId>soar-spring-boot-starter-job</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-jpamodelgen</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>